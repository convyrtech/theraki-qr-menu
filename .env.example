# Пример переменных окружения. Реальные значения — в .env.local (НЕ коммитить)
# и в настройках проекта Vercel.

# Neon Postgres — приходит автоматически из интеграции Vercel (Marketplace).
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Telegram-бот админки меню
TG_BOT_TOKEN=123456789:AA...            # токен от @BotFather
TG_ADMIN_IDS=272887795                  # id админов через запятую (кому можно править меню)
TG_WEBHOOK_SECRET=любая-длинная-строка  # секрет вебхука (обязателен, fail-closed)
